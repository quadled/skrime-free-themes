{
  "manifest_version": 3,
  "name": "Custom Themes",
  "version": "1.2.0",
  "description": "Custom Themes für Skrime.eu, 24fire.de und weitere Webseiten mit automatischem GitHub-Updater",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/quadled/skrime-free-themes/*",
    "https://api.github.com/repos/quadled/skrime-free-themes/*",
    "*://*.skrime.eu/*",
    "*://skrime.eu/*",
    "*://*.24fire.de/*",
    "*://24fire.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Custom Themes",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.skrime.eu/*",
        "*://skrime.eu/*",
        "*://*.24fire.de/*",
        "*://24fire.de/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}